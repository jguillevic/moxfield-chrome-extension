{
  "manifest_version": 3,
  "name": "Moxfield Stock Manager",
  "version": "0.2.0",
  "description": "Gère un stock de cartes physiques à partir de ta collection Moxfield. Flag un deck comme 'monté' pour décrémenter automatiquement le stock.",
  "key": "",
  "permissions": ["storage", "clipboardRead", "identity", "identity.email", "alarms"],
  "oauth2": {
    "client_id": "494997360432-8sd2j9ajhke5bfd3ra8b8rn0lc15r82t.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/drive.appdata"]
  },
  "host_permissions": [
    "https://www.moxfield.com/*",
    "https://moxfield.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Moxfield Stock Manager",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.moxfield.com/*",
        "https://moxfield.com/*"
      ],
      "js": ["content-deck.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon32.png"],
      "matches": ["https://www.moxfield.com/*", "https://moxfield.com/*"]
    }
  ],
  "minimum_chrome_version": "111"
}
